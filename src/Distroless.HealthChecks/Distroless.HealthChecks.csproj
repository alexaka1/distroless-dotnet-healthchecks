<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />
  <PropertyGroup Label="Package">
    <PackageId>Alexaka1.Distroless.HealthChecks</PackageId>
    <Description>A simple .NET app, that is able to perform health checks inside a distroless container that only has the .NET runtime as a dependency.</Description>
    <Authors>Alex Martossy</Authors>
    <PackageTags>docker;healthcheck;dotnet;distroless;chiseled-container</PackageTags>
    <PackageProjectUrl>https://github.com/alexaka1/distroless-dotnet-healthchecks</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="AOT" Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <!-- https://learn.microsoft.com/en-us/dotnet/core/deploying/trimming/trimming-options#trim-framework-library-features-->
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <Http3Support>false</Http3Support>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    Clang is the native linker driver, and -Wl splits on commas, so the JSON is one -Xlinker argument.
    Single quotes survive the /bin/sh invocation MSBuild uses for the link command.
  -->
  <PropertyGroup Label="Package metadata" Condition="'$(PublishAot)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <ElfPackageArchitecture Condition="$([System.String]::Copy('$(RuntimeIdentifier)').Contains('arm64'))">aarch64</ElfPackageArchitecture>
    <ElfPackageArchitecture Condition="'$(ElfPackageArchitecture)' == ''">x86_64</ElfPackageArchitecture>
    <ElfPackageMetadata>{"type":"generic","name":"$(PackageId)","version":"$(Version)","architecture":"$(ElfPackageArchitecture)","system":"nuget","license":"$(PackageLicenseExpression)"}</ElfPackageMetadata>
  </PropertyGroup>
  <ItemGroup Condition="'$(ElfPackageMetadata)' != ''">
    <LinkerArg Include="-Xlinker '--package-metadata=$(ElfPackageMetadata)'" />
  </ItemGroup>

  <PropertyGroup Label="Source generation">
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.2.26504.105"/>
  </ItemGroup>

  <PropertyGroup Label="Supply chain auditing">
    <!--    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>-->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateContainerSbom" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <PropertyGroup>
      <_CycloneDxManifest>$(MSBuildThisFileDirectory)../../.config/dotnet-tools.json</_CycloneDxManifest>
      <_RuntimePackScript>$(MSBuildThisFileDirectory)../../build/include-runtime-packs.cs</_RuntimePackScript>
      <_ContainerSbomDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_ContainerSbomDirectory>
      <_ContainerSbom>$([System.IO.Path]::Combine('$(_ContainerSbomDirectory)', 'Distroless.HealthChecks.cdx.json'))</_ContainerSbom>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CycloneDxManifest)')" Text="CycloneDX tool manifest was not found at '$(_CycloneDxManifest)'." />
    <Error Condition="!Exists('$(_RuntimePackScript)')" Text="Runtime pack SBOM script was not found at '$(_RuntimePackScript)'." />
    <Exec
      Command="dotnet tool run dotnet-CycloneDX --tool-manifest &quot;$(_CycloneDxManifest)&quot; -- &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(_ContainerSbomDirectory)&quot; --filename Distroless.HealthChecks.cdx.json --disable-package-restore --no-serial-number --spec-version 1.6 --runtime $(RuntimeIdentifier) --set-name $(PackageId) --set-version $(Version) --set-nuget-purl"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major;DOTNET_CLI_TELEMETRY_OPTOUT=1;DOTNET_NOLOGO=1" />
    <Exec
      Command="dotnet run --file &quot;$(_RuntimePackScript)&quot; -- --assets &quot;$(ProjectAssetsFile)&quot; --sbom &quot;$(_ContainerSbom)&quot; --runtime $(RuntimeIdentifier)"
      EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1;DOTNET_NOLOGO=1" />
  </Target>
</Project>
